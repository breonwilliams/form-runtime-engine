# Development/Testing artifacts
vendor/
build/
.phpunit.result.cache

# The test suite IS tracked. It was ignored until 1.8.6, which meant the
# plugin's only automated safety net lived on one machine: a fresh clone had
# no tests, no phpunit.xml and no way to install the WP test library, and
# nothing could run them in CI. That is how 14 field-validation tests stayed
# red indefinitely. tests/ is excluded from the release ZIP by the rsync
# exclude list in bin/build-release.sh, not by this file, so tracking them
# does not ship them.
composer
composer-setup.php

# IDE/Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local release builds (zips for hosted-site testing before a real GitHub release)
release/

# Claude workspace metadata is local, EXCEPT the verification gates: the
# project hooks and the settings that arm them are tracked so a change to
# what "verified" means shows up in a diff (see "Verification gates" in
# CLAUDE.md). settings.local.json stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/
